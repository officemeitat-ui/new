{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "DATABASE_URL_TEST", "REDIS_URL", "APP_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": ["*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "passThroughEnv": ["*"],
      "cache": false,
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    }
  }
}
