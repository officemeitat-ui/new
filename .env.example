# Kopieren nach .env und anpassen. Leere Werte gelten als nicht gesetzt.
# Alle Variablen werden beim Start geprüft (packages/core/src/env.ts).

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# --- Datenbank & Queue (docker compose up -d) ---
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
# Nur für Tests; die Rolle darf weder SUPERUSER noch BYPASSRLS haben.
DATABASE_URL_TEST=postgres://nexus:nexus@localhost:5432/nexus_test
REDIS_URL=redis://localhost:6379
WORKER_HEALTH_PORT=3001

# --- Anmeldung (Better Auth) ---
# Erzeugen mit: openssl rand -base64 32   (in Produktion Pflicht)
BETTER_AUTH_SECRET=

# SSO – wird nur aktiviert, wenn gesetzt
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Microsoft 365 / Intune / SharePoint connection (docs/adr/0008): own multi-tenant app
# registration with application permissions DeviceManagementManagedDevices.Read.All,
# DeviceManagementManagedDevices.PrivilegedOperations.All, Organization.Read.All and
# Sites.Read.All, plus the delegated permission User.Read (proves the customer's directory).
# Redirect URI (web): <APP_URL>/api/integrations/microsoft365/callback
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- KI ---
# anthropic (Claude API) | bedrock (Amazon Bedrock, EU-Region) | vertex (Google Vertex AI, EU)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Nur für Tests: Mock der Claude API (apps/web/e2e/mock-anthropic.mjs)
# ANTHROPIC_BASE_URL=http://localhost:4010
WORKER_AGENT_CONCURRENCY=4
AWS_REGION=eu-central-1
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_REGION=eu

# --- E-Mail (lokal: Mailpit unter http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ME-IT Nexus <noreply@localhost>"

# --- Branding (Standard für die Plattform; Mandanten überschreiben das) ---
BRAND_PRODUCT_NAME="ME-IT Nexus"
BRAND_PRIMARY_COLOR=#2454d6

# Hosting provider and location for the subprocessor list (Einstellungen → Datenschutz),
# e.g. "Hetzner Online GmbH, Falkenstein (DE)".
HOSTING_DESCRIPTION=
