# ── Grundeinstellungen ──────────────────────────────────────────────
# Passwort für das Cockpit (/admin). Ohne Passwort ist das Cockpit gesperrt.
ADMIN_PASSWORD=
# Geheimnis zum Signieren der Cockpit-Session (z. B. `openssl rand -hex 32`).
SESSION_SECRET=
# Öffentliche Adresse dieser Installation (https), z. B. https://cockpit.kunde.at
PUBLIC_URL=

# Datenbank: lokal eine SQLite-Datei, in Produktion z. B. Turso (libsql://…).
DATABASE_URL=file:data/app.db
DATABASE_AUTH_TOKEN=

# ── KI (Claude) ─────────────────────────────────────────────────────
# Für E-Mail-Assistent, Gesprächsvorbereitung und Follow-up-Entwürfe.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Telefon-Assistent (Vapi) ────────────────────────────────────────
# Geheimnis, mit dem sich Vapi bei diesem Cockpit ausweist (z. B. `openssl rand -hex 32`).
VAPI_WEBHOOK_SECRET=
# Nur für `npm run vapi:connect`: API-Schlüssel und die zu verbindende Nummer.
VAPI_API_KEY=
VAPI_PHONE_NUMBER=
# Optional: Sprachmodell und Stimme des Telefon-Assistenten.
VAPI_LLM_MODEL=claude-sonnet-5
VAPI_VOICE_ID=de-AT-IngridNeural

# ── WhatsApp-Assistent (WhatsApp Cloud API von Meta) ────────────────
WHATSAPP_PHONE_NUMBER_ID=
# Dauerhaftes Zugriffstoken eines Systembenutzers (Berechtigung whatsapp_business_messaging).
WHATSAPP_ACCESS_TOKEN=
# App-Geheimnis der Meta-App – damit wird die Signatur jedes Webhooks geprüft.
WHATSAPP_APP_SECRET=
# Frei gewählte Zeichenkette, die bei der Webhook-Einrichtung in Meta eingetragen wird.
WHATSAPP_VERIFY_TOKEN=
# Optional: Graph-API-Version und Sprachmodell des Chat-Assistenten.
WHATSAPP_API_VERSION=v24.0
CHAT_MODEL=claude-opus-5-5

# ── E-Mail-Assistent ────────────────────────────────────────────────
# Postfach, das der Assistent liest (IMAP) …
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# … und über das Antworten verschickt werden (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Betrieb <office@example.at>"
# Schützt die regelmäßigen Aufgaben unter /api/cron/… (Postfach, Erinnerungen, Nachfassen, Monatsbericht).
CRON_SECRET=

# ── Kalender des Betriebs ───────────────────────────────────────────
# intern (Standard) | google | microsoft. Bei google/microsoft zählen Einträge dort als belegt,
# neue Buchungen werden eingetragen. Ist der Kalender nicht erreichbar, wird nicht gebucht.
CALENDAR_PROVIDER=intern
# Google: Inhalt der JSON-Schlüsseldatei des Dienstkontos (eine Zeile) und die Kalender-ID.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Microsoft 365: App-Registrierung (Kalender: Calendars.ReadWrite, Postfach: Mail.ReadWrite – nie Mail.Send).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALENDAR_USER=
# Postfach, das der E-Mail-Assistent über Microsoft 365 liest (statt IMAP). Entwürfe landen dort in Outlook.
MS_MAILBOX=
# Wie viele Tage zurück der Posteingang gelesen wird.
MS_MAIL_LOOKBACK_DAYS=2

# ── SMS (Terminbestätigungen und -erinnerungen) ─────────────────────
# Twilio-Zugang und Absendernummer (SMS-fähig). Ohne SMS gehen Bestätigungen per E-Mail raus.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Benachrichtigungen & Integrationen ──────────────────────────────
# Team-Adresse für Rückrufwünsche, neue Termine und dringende E-Mails.
TEAM_NOTIFY_EMAIL=
# Empfänger des Monatsberichts (sonst TEAM_NOTIFY_EMAIL).
REPORT_EMAIL=
# Terminbuchung nach erfolgreicher Potentialanalyse auf der Website (Cal.com, Calendly, …).
BOOKING_URL=
# Optional: Webhook für CRM/n8n/Make/Zapier – erhält alle Ereignisse (siehe README).
WEBHOOK_URL=
WEBHOOK_SECRET=
