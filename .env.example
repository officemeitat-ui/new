# Kopieren nach .env und anpassen. Danach App neu starten.

MEIT_COMPANY=ME-IT
MEIT_DB=data/meit.db
MEIT_HOST=127.0.0.1
MEIT_PORT=8080
# Demodaten beim ersten Start anlegen (für echten Betrieb: false + leere Datenbank)
MEIT_SEED_DEMO=true
# Passwort setzen, sobald die App im Netzwerk erreichbar ist (MEIT_HOST=0.0.0.0)
MEIT_PASSWORD=

# --- KI -----------------------------------------------------------------------
# ollama (offline, empfohlen) | openai (LM Studio, llama.cpp, vLLM) | anthropic (Claude, Cloud) | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Schwacher PC: qwen3:8b · 16-24 GB VRAM: qwen3:14b · RTX 5090: qwen3:32b · eigenes Modell: meit-assistent
OLLAMA_MODEL=qwen3:14b
EMBED_MODEL=bge-m3
LLM_TIMEOUT=180

# OpenAI-kompatibler lokaler Server (z. B. LM Studio)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model

# Claude (Cloud) – nur für nicht sensible Daten. Wird nur genutzt, wenn
# LLM_PROVIDER=anthropic oder ALLOW_CLOUD_FALLBACK=true (und lokal nichts läuft).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ALLOW_CLOUD_FALLBACK=false

# --- KI-Mitarbeiter: Postfach ----------------------------------------------------
# imap (klassisch: IMAP/SMTP) oder graph (Microsoft 365 über Microsoft Graph)
MAIL_PROVIDER=imap
# Microsoft 365 – App-Registrierung mit Mail.ReadWrite + Mail.Send (siehe docs/KI-MITARBEITER.md)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
# Terminvorschläge aus dem M365-Kalender in Antworten (zusätzlich Calendars.Read freigeben)
GRAPH_CALENDAR=false
# IMAP/SMTP (alle anderen Anbieter)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# MAIL_SMTP_USER/PASSWORD: leer = wie IMAP
MAIL_FROM=
# automatisch abrufen alle X Minuten (0 = nur per Knopf "Postfach abrufen")
MAIL_POLL_MINUTES=0
# Terminbuchungs-Link für Interessenten (optional)
BOOKING_URL=
# Nachfassen nach X Tagen ohne Antwort (Angebote/Leads)
FOLLOWUP_DAYS=5
# Öffentliches Anfrageformular /anfrage
PUBLIC_FORM_ENABLED=true
# Websites, die das Formular per JavaScript ansprechen dürfen (kommagetrennt)
PUBLIC_FORM_ORIGINS=

# --- Datensicherung -------------------------------------------------------------
# automatisch alle X Stunden (0 = aus), Anzahl aufbewahrter Sicherungen, Ordner (leer = data/backups)
BACKUP_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR=

# --- Dokumentenarchiv (Rechnungen, Angebote, Belege, Berichte als PDF) ----------
# leer = data/archiv. Tipp: einen per OneDrive-Client synchronisierten Ordner angeben,
# z. B. C:\Users\office\OneDrive - ME-IT\Archiv – dann landet alles auch ohne Graph-Rechte in OneDrive.
# SharePoint-/OneDrive-Upload über Microsoft Graph: in der App unter Einstellungen → Dokumentenablage
# (nutzt GRAPH_TENANT_ID/GRAPH_CLIENT_ID/GRAPH_CLIENT_SECRET von oben).
ARCHIVE_DIR=

# --- Öffentliche Adresse des Cockpits (Links in Mails, z. B. Zufriedenheits-Umfrage) ---
# z. B. https://cockpit.meit.at – ohne diese Adresse ist die Bewertung nur im Kundenportal möglich
PUBLIC_URL=

# --- RMM: Atera (Admin → API → API-Schlüssel kopieren) --------------------------
# Kunden + Geräte (inkl. Link zur Atera-Geräteseite → Splashtop) abgleichen, optional Alarme als Tickets.
ATERA_API_KEY=
ATERA_SYNC_HOURS=6
ATERA_ALERT_TICKETS=false

# --- BookStack (Profil → API-Token; Rolle braucht „Zugriff auf System-API“) -------
# Kundendokumentation automatisch pflegen, Wissensartikel synchronisieren, Wiki-Seiten als KI-Wissen
BOOKSTACK_URL=
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
BOOKSTACK_SYNC_HOURS=0

# --- RMM: NinjaOne (Administration → Apps → API, Client Credentials, Scope Monitoring) ---
# z. B. https://eu.ninjarmm.com (EU) oder https://app.ninjarmm.com (US)
NINJA_URL=
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
# automatisch alle X Stunden abgleichen (0 = nur per Knopf)
NINJA_SYNC_HOURS=0
# NinjaOne-Alarme als Tickets anlegen
NINJA_ALERT_TICKETS=false

# --- Sprachnotizen (optional: pip install -r requirements-voice.txt) ---------------
# Modell: tiny | base | small | medium | large-v3 (größer = genauer, langsamer); Gerät: auto | cpu | cuda
WHISPER_MODEL=small
WHISPER_DEVICE=auto
