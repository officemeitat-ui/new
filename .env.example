# Passwort für den Admin-Bereich (/admin). Ohne Passwort ist der Admin-Bereich gesperrt.
ADMIN_PASSWORD=
# Geheimnis zum Signieren der Admin-Session (lange Zufallszeichenkette, z. B. `openssl rand -hex 32`).
SESSION_SECRET=

# Datenbank: lokal eine SQLite-Datei, in Produktion z. B. Turso (libsql://…).
DATABASE_URL=file:data/app.db
DATABASE_AUTH_TOKEN=

# Terminbuchung nach erfolgreicher Vorqualifizierung (Cal.com, Calendly, …).
BOOKING_URL=

# Optional: Webhook für CRM/n8n/Make/Zapier – erhält lead.created und lead.stage_changed.
WEBHOOK_URL=
# Optional: signiert Webhooks per HMAC-SHA256 (Header X-Signature).
WEBHOOK_SECRET=

# KI-Funktionen (Gesprächsvorbereitung, Follow-up-Entwurf).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
