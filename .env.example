# Kopieren nach .env und anpassen. Danach App neu starten.

MEIT_COMPANY=ME-IT
MEIT_DB=data/meit.db
MEIT_HOST=127.0.0.1
MEIT_PORT=8080
# Demodaten beim ersten Start anlegen (für echten Betrieb: false + leere Datenbank)
MEIT_SEED_DEMO=true
# Passwort setzen, sobald die App im Netzwerk erreichbar ist (MEIT_HOST=0.0.0.0)
MEIT_PASSWORD=

# --- KI -----------------------------------------------------------------------
# ollama (offline, empfohlen) | openai (LM Studio, llama.cpp, vLLM) | anthropic (Claude, Cloud) | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Schwacher PC: qwen3:8b · 16-24 GB VRAM: qwen3:14b · RTX 5090: qwen3:32b · eigenes Modell: meit-assistent
OLLAMA_MODEL=qwen3:14b
EMBED_MODEL=bge-m3
LLM_TIMEOUT=180

# OpenAI-kompatibler lokaler Server (z. B. LM Studio)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model

# Claude (Cloud) – nur für nicht sensible Daten. Wird nur genutzt, wenn
# LLM_PROVIDER=anthropic oder ALLOW_CLOUD_FALLBACK=true (und lokal nichts läuft).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ALLOW_CLOUD_FALLBACK=false
