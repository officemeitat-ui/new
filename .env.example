# Kopieren nach .env und anpassen. Danach App neu starten.

MEIT_COMPANY=ME-IT
MEIT_DB=data/meit.db
MEIT_HOST=127.0.0.1
MEIT_PORT=8080
# Demodaten beim ersten Start anlegen (für echten Betrieb: false + leere Datenbank)
MEIT_SEED_DEMO=true
# Passwort setzen, sobald die App im Netzwerk erreichbar ist (MEIT_HOST=0.0.0.0)
MEIT_PASSWORD=

# --- KI -----------------------------------------------------------------------
# ollama (offline, empfohlen) | openai (LM Studio, llama.cpp, vLLM) | anthropic (Claude, Cloud) | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Schwacher PC: qwen3:8b · 16-24 GB VRAM: qwen3:14b · RTX 5090: qwen3:32b · eigenes Modell: meit-assistent
OLLAMA_MODEL=qwen3:14b
EMBED_MODEL=bge-m3
LLM_TIMEOUT=180

# OpenAI-kompatibler lokaler Server (z. B. LM Studio)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model

# Claude (Cloud) – nur für nicht sensible Daten. Wird nur genutzt, wenn
# LLM_PROVIDER=anthropic oder ALLOW_CLOUD_FALLBACK=true (und lokal nichts läuft).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ALLOW_CLOUD_FALLBACK=false

# --- KI-Mitarbeiter: Postfach ----------------------------------------------------
# Microsoft 365: Passwort-Anmeldung per IMAP/SMTP ist dort abgeschaltet → siehe docs/KI-MITARBEITER.md
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# MAIL_SMTP_USER/PASSWORD: leer = wie IMAP
MAIL_FROM=
# automatisch abrufen alle X Minuten (0 = nur per Knopf "Postfach abrufen")
MAIL_POLL_MINUTES=0
# Terminbuchungs-Link für Interessenten (optional)
BOOKING_URL=
# Nachfassen nach X Tagen ohne Antwort (Angebote/Leads)
FOLLOWUP_DAYS=5
# Öffentliches Anfrageformular /anfrage
PUBLIC_FORM_ENABLED=true
# Websites, die das Formular per JavaScript ansprechen dürfen (kommagetrennt)
PUBLIC_FORM_ORIGINS=
