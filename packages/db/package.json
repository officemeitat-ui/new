{
  "name": "@nexus/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@nexus/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
