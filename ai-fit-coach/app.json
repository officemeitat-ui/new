{
  "expo": {
    "name": "AI FIT COACH",
    "slug": "ai-fit-coach",
    "scheme": "aifitcoach",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D0C",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0B0D0C" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "at.meit.aifitcoach" },
    "android": {
      "package": "at.meit.aifitcoach",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0B0D0C" }
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png", "themeColor": "#0B0D0C", "backgroundColor": "#0B0D0C" }
  }
}
