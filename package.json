{
  "name": "einsatzplaner-reinigung",
  "version": "1.0.0",
  "description": "Dienstplan für die Gebäudereinigung: automatische Einsatzplanung mit österreichischem Arbeitsrecht, Ablage in SharePoint",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "build": "node scripts/build.js",
