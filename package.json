    "hochladen": "node scripts/build.js && node scripts/hochladen.js",
    "test": "node --test",
    "theme": "node scripts/theme-from-site.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@azure/msal-browser": "3.30.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pdfmake": "0.2.20"
  },
  "devDependencies": {
    "basic-ftp": "6.2.3",
    "esbuild": "0.25.12"
  }
}
